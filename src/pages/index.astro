---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import House from '../components/House.astro';
import Rooms from '../components/Rooms.astro';
import Grounds from '../components/Grounds.astro';
import Visit from '../components/Visit.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
---
<BaseLayout>
  <Header />
  <main id="main">
    {site.sections.hero && <Hero />}
    {site.sections.house && <House />}
    {site.sections.rooms && <Rooms />}
    {site.sections.grounds && <Grounds />}
    {site.sections.visit && <Visit />}
    {site.sections.contact && <Contact />}
  </main>
  <Footer />
</BaseLayout>
